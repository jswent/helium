 namespace {
+int CountLeadingPixels(views::View* tab, SkColor color) {
+  // Views paints each composited layer relative to its own root.
+  views::View* root = tab;
+  while (root->parent() && !root->layer()) {
+    root = root->parent();
+  }
+  const auto bitmap = views::test::PaintViewToBitmap(root);
+  gfx::Rect bounds = views::View::ConvertRectToTarget(
+      tab, root, gfx::Rect(std::min(36, tab->width()), tab->height()));
+  bounds.Intersect(gfx::Rect(bitmap.width(), bitmap.height()));
+  int count = 0;
+  for (int y = bounds.y(); y < bounds.bottom(); ++y) {
+    for (int x = bounds.x(); x < bounds.right(); ++x) {
+      count += bitmap.getColor(x, y) == color;
+    }
+  }
+  return count;
+}
