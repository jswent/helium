+
+int TabStyleViews::GetContainerAccentInset(int width) const {
+  if (!container_accent_ || delegate()->IsPinned()) {
+    return 0;
+  }
+  const int min_width =
+      orientation_ == TabStripOrientation::kVertical
+          ? tabs::kVerticalTabStripCollapsedWidth + ContainerTabAccent::kWidth
+          : tab_style()->GetStandardWidth(delegate()->IsSplit()) / 2;
+  return width >= min_width ? ContainerTabAccent::kWidth : 0;
+}
