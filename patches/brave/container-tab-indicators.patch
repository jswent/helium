+using helium::containers::Entry;
+using helium::containers::Icon;
+
+namespace {
+const std::string* ContainerIdForTab(const tabs::TabInterface* tab) {
+  auto* contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return nullptr;
+  }
+  const auto& config = contents->GetSiteInstance()
+                           ->GetSecurityPrincipal()
+                           .GetStoragePartitionConfig();
+  return config.partition_domain() == helium::containers::kPartitionDomain
+             ? &config.partition_name()
+             : nullptr;
+}
+}  // namespace
+
+void ContainerTabAccent::Update(std::unique_ptr<ContainerTabAccent>& accent,
+                                const tabs::TabInterface* tab,
+                                views::View& view) {
+  if (!base::FeatureList::IsEnabled(
+          helium::containers::kHeliumNamedContainers)) {
+    return;
+  }
+  const auto* id = ContainerIdForTab(tab);
+  if (id && helium::containers::IsAvailable(tab->GetProfile())) {
+    auto& profile = *tab->GetProfile();
+    if (!accent || accent->entry_.id != *id || &*accent->profile_ != &profile) {
+      accent.reset(new ContainerTabAccent(profile, view, *id));
+      view.InvalidateLayout();
+    }
+  } else if (accent) {
+    accent.reset();
+    view.GetViewAccessibility().RemoveDescription();
+    view.InvalidateLayout();
+    view.SchedulePaint();
+  }
+}
+
+ContainerTabAccent::ContainerTabAccent(Profile& profile,
+                                       views::View& view,
+                                       const std::string& id)
+    : profile_(profile), view_(view), entry_{id, {}, Icon::kPerson, 0} {
+  prefs_.Init(profile.GetPrefs());
+  auto changed = base::BindRepeating(&ContainerTabAccent::RefreshAppearance,
+                                     base::Unretained(this));
+  if (id.starts_with("t-")) {
+    prefs_.Add(prefs::kHeliumTemporaryContainers, changed);
+  } else {
+    prefs_.Add(prefs::kHeliumNamedContainers, changed);
+    prefs_.Add(helium::containers::kAppearancePref, changed);
+  }
+  RefreshAppearance();
+}
+
+ContainerTabAccent::~ContainerTabAccent() = default;
+
+void ContainerTabAccent::RefreshAppearance() {
+  // A deleted or unsynced container tab still belongs to its own partition.
+  auto entry = helium::containers::FindById(&*profile_, entry_.id)
+                   .value_or(Entry{entry_.id, {}, Icon::kPerson, 0x74787e});
+  if (entry.name == entry_.name && entry.color == entry_.color &&
+      entry.icon == entry_.icon) {
+    return;
+  }
+  entry_ = std::move(entry);
+  const auto description =
+      entry_.name.empty()
+          ? l10n_util::GetStringUTF16(IDS_HELIUM_TAB_UNKNOWN_CONTAINER)
+          : l10n_util::GetStringFUTF16(
+                entry_.id.starts_with("t-")
+                    ? IDS_HELIUM_TAB_TEMPORARY_CONTAINER_DESCRIPTION
+                    : IDS_HELIUM_TAB_CONTAINER_DESCRIPTION,
+                base::UTF8ToUTF16(entry_.name));
+  view_->GetViewAccessibility().SetDescription(description);
+  icon_ = {};
+  view_->SchedulePaint();
+}
+
+void ContainerTabAccent::Paint(gfx::Canvas* canvas,
+                               const TabStyleViews& style) {
+  const SkPath outline =
+      style.GetPath(TabStyle::PathType::kHighlight, canvas->image_scale(),
+                    {.render_units = TabStyle::RenderUnits::kDips});
+  const SkRect bounds = outline.getBounds();
+  if (bounds.isEmpty()) {
+    return;
+  }
+
+  const bool large = style.GetContainerAccentInset(view_->width()) > 0;
+  const SkColor accent = SkColorSetA(entry_.color, SK_AlphaOPAQUE);
+  const auto* delegate = style.delegate();
+  const bool active = delegate->IsActive();
+  const SkColor surface =
+      view_->GetColorProvider()->GetColor(ui::kColorWindowBackground);
+  const SkColor base =
+      color_utils::IsDark(surface) ? SK_ColorBLACK : SK_ColorWHITE;
+  const SkColor fill =
+      active ? accent
+             : color_utils::AlphaBlend(accent, base,
+                                       delegate->IsHovering() ? 0.4f : 0.22f);
+  const SkColor foreground =
+      color_utils::BlendForMinContrast(
+          active ? SK_ColorWHITE : accent, fill, std::nullopt,
+          color_utils::kMinimumVisibleContrastRatio)
+          .color;
+
+  gfx::ScopedCanvas scoped(canvas);
+  canvas->ClipPath(outline, true);
+  // Views mirrors child positions in RTL. Mirror only the accent geometry,
+  // leaving the actual tab outline and the icon artwork in physical
+  // coordinates.
+  const bool rtl = view_->GetMirroredXInView(0) != 0;
+  const int width = large ? kWidth : 14;
+  const int left =
+      rtl ? std::floor(bounds.right()) - width : std::ceil(bounds.left());
+  const int center_x = left + width / 2;
+  const int center_y = large ? std::round(bounds.centerY())
+                             : std::floor(bounds.bottom()) - width / 2 - 1;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(fill);
+  if (large) {
+    // Subtract a rounded inner edge from the leading 22 DIP of the tab.
+    gfx::ScopedCanvas fill_canvas(canvas);
+    SkRect inner = bounds;
+    inner.offset(rtl ? -width : width, 0);
+    canvas->ClipPath(SkPath::RRect(SkRRect::MakeRectXY(inner, 7, 7)), true,
+                     SkClipOp::kDifference);
+    canvas->DrawPath(outline, flags);
+  } else {
+    canvas->DrawCircle(gfx::PointF(center_x, center_y), width / 2.f, flags);
+  }
+
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setColor(fill);
+  flags.setStrokeWidth(2.f / canvas->image_scale());
+  canvas->DrawPath(outline, flags);
+
+  const int size = large ? 16 : 10;
+  if (icon_.isNull() || icon_.width() != size || icon_color_ != foreground) {
+    icon_ =
+        helium::containers::ContainerForegroundIcon(entry_, size, foreground);
+    icon_color_ = foreground;
+  }
+  canvas->DrawImageInt(icon_, center_x - size / 2, center_y - size / 2);
+}
