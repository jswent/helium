+void Move(Profile* profile, const std::string& id, const std::string& target) {
+  if (!ShouldShowControls(profile) || id == target) {
+    return;
+  }
+  // Rebuild from the current list so a stale settings page cannot drop an
+  // entry created in another window or resurrect a deleted one.
+  auto entries = List(profile);
+  auto from = std::ranges::find(entries, id, &Entry::id);
+  auto to = std::ranges::find(entries, target, &Entry::id);
+  if (from == entries.end() || to == entries.end()) {
+    return;
+  }
+  if (from < to) {
+    std::rotate(from, from + 1, to + 1);
+  } else {
+    std::rotate(to, from, from + 1);
+  }
+  base::ListValue order;
+  for (const auto& entry : entries) {
+    order.Append(entry.id);
+  }
+  profile->GetPrefs()->SetList(prefs::kHeliumContainerOrder, std::move(order));
 }
 
