+
+std::string SerializedNavigationEntry::named_container_id() const {
+  const auto it = extended_info_map_.find(kNamedContainerId);
+  return it == extended_info_map_.end() ? std::string() : it->second;
+}
+
+void SerializedNavigationEntry::set_named_container_id(const std::string& id) {
+  CHECK(base::Uuid::ParseLowercase(id).is_valid());
+  extended_info_map_[kNamedContainerId] = id;
+}
+
+bool SerializedNavigationEntry::HasContainerScheme(const GURL& url) {
+  return url.scheme().starts_with(kContainerSchemePrefix);
+}
+
+std::string SerializedNavigationEntry::ContainerIdFromStorageURL(
+    const GURL& url) {
+  if (!HasContainerScheme(url)) {
+    return {};
+  }
+  return base::Uuid::ParseLowercase(
+             url.scheme().substr(sizeof(kContainerSchemePrefix) - 1))
+      .AsLowercaseString();
+}
+
+GURL SerializedNavigationEntry::WrapContainerURL(const GURL& url,
+                                                 std::string_view id) {
+  if (!url.is_valid() || !base::Uuid::ParseLowercase(id).is_valid()) {
+    return GURL();
+  }
+  return GURL(base::StrCat({kContainerSchemePrefix, id, ":", url.spec()}));
+}
+
+GURL SerializedNavigationEntry::UnwrapContainerURL(const GURL& url,
+                                                   std::string_view id) {
+  if (!url.is_valid() || !base::Uuid::ParseLowercase(id).is_valid() ||
+      url.scheme() != base::StrCat({kContainerSchemePrefix, id})) {
+    return GURL();
+  }
+  return GURL(std::string_view(url.spec()).substr(url.scheme().size() + 1));
+}
+
+GURL SerializedNavigationEntry::VirtualURLForStorage() const {
+  const std::string id = named_container_id();
+  if (id.empty()) {
+    return HasContainerScheme(virtual_url_) ? GURL(url::kAboutBlankURL)
+                                            : virtual_url_;
+  }
+  return HasContainerScheme(virtual_url_) ? virtual_url_
+                                          : WrapContainerURL(virtual_url_, id);
+}
