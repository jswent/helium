+  if (!blink::DecodePageState(encoded, &state) || !state.top.url_string) {
+    return {};
+  }
+  const GURL wrapped = SerializedNavigationEntry::WrapContainerURL(
+      GURL(*state.top.url_string), id);
+  if (!wrapped.is_valid()) {
+    return {};
+  }
+  state.top.url_string = base::UTF8ToUTF16(wrapped.spec());
+  blink::EncodePageState(state, &encoded);
+  return encoded;
 }
 
 void ContentSerializedNavigationDriver::Sanitize(
     SerializedNavigationEntry* navigation) const {
+  const std::string id = navigation->named_container_id();
+  if (id.empty() && !SerializedNavigationEntry::HasContainerScheme(
+                        navigation->virtual_url())) {
+    return;
+  }
+  const GURL original = SerializedNavigationEntry::UnwrapContainerURL(
+      navigation->virtual_url(), id);
+  if (!original.is_valid()) {
+    // An incomplete record, or a literal reserved scheme with no browser key.
+    const int index = navigation->index();
+    *navigation = SerializedNavigationEntry();
+    navigation->set_index(index);
+    navigation->set_virtual_url(GURL(url::kAboutBlankURL));
+    return;
+  }
+  if (!base::FeatureList::IsEnabled(
+          helium::containers::kHeliumNamedContainers)) {
+    return;  // Keep the wire representation intact while the feature is off.
+  }
+  navigation->set_virtual_url(original);
+  if (!navigation->encoded_page_state().empty()) {
+    blink::ExplodedPageState state;
+    std::string decoded;
+    if (blink::DecodePageState(navigation->encoded_page_state(), &state) &&
+        state.top.url_string) {
+      const GURL actual = SerializedNavigationEntry::UnwrapContainerURL(
+          GURL(*state.top.url_string), id);
+      if (actual.is_valid()) {
+        state.top.url_string = base::UTF8ToUTF16(actual.spec());
+        blink::EncodePageState(state, &decoded);
+      }
+    }
+    navigation->set_encoded_page_state(decoded);
+  }
 }
 
