+#ifndef CHROME_BROWSER_CONTAINERS_NAMED_CONTAINERS_H_
+#define CHROME_BROWSER_CONTAINERS_NAMED_CONTAINERS_H_
+
+#include <string>
+#include <vector>
+
+#include "base/functional/callback_forward.h"
+#include "content/public/browser/storage_partition_config.h"
+
+class Profile;
+
+namespace helium::containers {
+
+// Display metadata is keyed by UUID. The original name-to-UUID preference
+// remains readable by existing profiles and the command-line launcher.
+inline constexpr char kAppearancePref[] = "helium.containers.appearance";
+enum class Icon {
+  kPerson,
+  kWork,
+  kGroup,
+  kStar,
+  kHome,
+  kTravel,
+  kMaxValue = kTravel
+};
+struct Entry {
+  std::string id;
+  std::string name;
+  Icon icon;
+  int color;  // Opaque RGB.
+};
+
+bool IsAvailable(Profile* profile);
+std::vector<Entry> List(Profile* profile);
+bool HasId(Profile* profile, const std::string& id);
+content::StoragePartitionConfig GetOrCreateNamedPartition(
+    Profile* profile,
+    const std::string& name);
+
+// Empty ID creates a container. Renames retain the UUID and its storage.
+// Returns an empty string on success or a WebUI error key.
+std::string Save(Profile* profile,
+                 const std::string& id,
+                 const std::string& name,
+                 int icon,
+                 int color);
+void Remove(Profile* profile,
+            const std::string& id,
+            base::OnceCallback<void(bool)> complete);
+
+}  // namespace helium::containers
+#endif  // CHROME_BROWSER_CONTAINERS_NAMED_CONTAINERS_H_
