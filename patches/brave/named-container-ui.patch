+export function colorHex(color: number): string {
+  return '#' + color.toString(16).padStart(6, '0');
+}
+
+export class SettingsContainersPageElement extends
+    SettingsViewMixinLit(WebUiListenerMixinLit(CrLitElement)) {
+  static get is() { return 'settings-containers-page'; }
+  static override get styles() { return getCss(); }
+  override render() { return getHtml.bind(this)(); }
+  static override get properties() {
+    return {
+      items_: {type: Array}, draft_: {type: Object}, deleting_: {type: Boolean},
+      busy_: {type: Boolean}, error_: {type: String},
+    };
+  }
+
+  protected accessor items_: ContainerEntry[] = [];
+  protected accessor draft_: ContainerEntry|null = null;
+  protected accessor deleting_: boolean = false;
+  protected accessor busy_: boolean = false;
+  protected accessor error_: string = '';
+  private trigger_: HTMLElement|null = null;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.addWebUiListener('named-containers-changed', (items: ContainerEntry[]) => {
+      this.items_ = items;
+    });
+    sendWithPromise<ContainerEntry[]>('getNamedContainers').then(items => {
+      this.items_ = items;
+    });
+  }
+
+  override focusBackButton() {
+    this.shadowRoot.querySelector('settings-subpage')!.focusBackButton();
+  }
+
+  private showEditor_(event: Event, item?: ContainerEntry, deleting = false) {
+    this.trigger_ = event.currentTarget as HTMLElement;
+    this.error_ = '';
+    this.deleting_ = deleting;
+    this.draft_ = item ? {...item} : {id: '', name: '', icon: 0, color: 0x3971ce};
+    this.updateComplete.then(() => {
+      this.shadowRoot.querySelector<CrInputElement>('#name')?.focus();
+    });
+  }
