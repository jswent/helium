+  }
+
+  TabStripModel* strip() { return browser()->GetTabStripModel(); }
+  content::WebContents* active() { return strip()->GetActiveWebContents(); }
+
+  // Use the same tab and Cocoa menu models as a right-click in the tab strip.
+  bool Select(const std::string& label, bool execute = true) {
+    TabMenuModel model(nullptr, TabMenuModelDelegate::From(browser()), strip(),
+                       strip()->active_index());
+    MenuControllerCocoa* controller =
+        [[MenuControllerCocoa alloc] initWithModel:&model
+                                     isContextMenu:YES
+                                          delegate:nil];
+    NSMenu* submenu =
+        [controller.menu itemWithTitle:@"Open in container"].submenu;
+    if (!submenu) {
+      return false;
+    }
+    const NSInteger index =
+        [submenu indexOfItemWithTitle:base::SysUTF8ToNSString(label)];
+    if (index < 0) {
+      return false;
+    }
+    if (execute) {
+      [submenu performActionForItemAtIndex:index];
+    }
+    return true;
+  }
+
+  void InstallSelectors(content::WebContents* settings) {
+    ASSERT_TRUE(content::ExecJs(settings, R"JS(
+      window.findControl = (selector, root = document) => {
+        const direct = root.querySelector(selector);
+        if (direct) return direct;
+        for (const el of root.querySelectorAll('*')) {
+          if (el.shadowRoot) {
+            const result = findControl(selector, el.shadowRoot);
+            if (result) return result;
+          }
+        }
+        return null;
+      };
+      window.untilUI = async f => {
+        for (let i = 0; i < 200; ++i) {
+          const value = f();
+          if (value) return value;
+          await new Promise(resolve => setTimeout(resolve, 25));
+        }
+        throw Error('Timed out waiting for container UI');
+      };
+      window.listRow = name => [...(findControl('settings-containers-page')?.shadowRoot
+        .querySelectorAll('.list-item') || [])].find(row => row.querySelector('.name').textContent.trim() === name);
+      window.editorSave = async name => {
+        const input = await untilUI(() => findControl('settings-containers-page').shadowRoot.querySelector('#name'));
+        const field = input.inputElement;
+        field.value = name;
+        field.dispatchEvent(new Event('input', {bubbles: true, composed: true}));
+        const confirm = await untilUI(() => {
+          const b = findControl('settings-containers-page').shadowRoot.querySelector('#confirm');
+          return b && !b.disabled && b;
+        });
+        confirm.click();
+        await untilUI(() => listRow(name) && !findControl('settings-containers-page').shadowRoot.querySelector('cr-dialog'));
+      };
+    )JS"));
+  }
+
+ private:
+  base::test::ScopedFeatureList features_;
+};
