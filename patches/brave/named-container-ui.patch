+
+namespace {
+// Disjoint from the tab group's, split view's and other tab submenus.
+constexpr int kNoContainer = 2200;
+constexpr int kManage = 2201;
+constexpr int kFirstContainer = 2202;
+constexpr int kLastContainer = 3201;
+
+GURL ReopenUrl(tabs::TabInterface* tab, BrowserWindowInterface* browser) {
+  if (!tab || tab->GetBrowserWindowInterface() != browser) {
+    return {};
+  }
+  const GURL& url = tab->GetContents()->GetLastCommittedURL();
+  if (url.SchemeIsHTTPOrHTTPS()) {
+    return url;
+  }
+  const GURL& visible = tab->GetContents()->GetVisibleURL();
+  if (visible == chrome::ChromeUINewTabURLAsGURL() || url.IsAboutBlank() ||
+      url == GURL(chrome::kChromeUINewTabPageURL)) {
+    return chrome::ChromeUINewTabURLAsGURL();
+  }
+  return {};
+}
+
+const gfx::VectorIcon& MenuIcon(helium::containers::Icon icon) {
+  using Icon = helium::containers::Icon;
+  switch (icon) {
+    case Icon::kPerson:
+      return kPersonFilledIcon;
+    case Icon::kWork:
+      return vector_icons::kDomainIcon;
+    case Icon::kGroup:
+      return kGroupCustomIcon;
+    case Icon::kStar:
+      return vector_icons::kStarFilledIcon;
+    case Icon::kHome:
+      return vector_icons::kHomeIcon;
+    case Icon::kTravel:
+      return vector_icons::kLocationOnIcon;
+  }
+  NOTREACHED();
+}
+}  // namespace
+
+NamedContainerMenuModel::NamedContainerMenuModel(
+    BrowserWindowInterface* browser,
+    std::vector<tabs::TabHandle> tabs)
+    : ui::SimpleMenuModel(this),
+      browser_(browser->GetWeakPtr()),
+      tabs_(std::move(tabs)) {
+  AddCheckItemWithStringId(kNoContainer, IDS_HELIUM_CONTAINER_NONE);
+  for (const auto& entry : helium::containers::List(browser->GetProfile())) {
+    const int command = kFirstContainer + static_cast<int>(ids_.size());
+    if (command > kLastContainer) {
+      break;
+    }
+    ids_.push_back(entry.id);
+    AddCheckItem(command, base::UTF8ToUTF16(entry.name));
+    SetMayHaveMnemonicsAt(GetItemCount() - 1, false);
+    SetIcon(GetItemCount() - 1,
+            ui::ImageModel::FromImageSkia(gfx::CreateVectorIcon(
+                MenuIcon(entry.icon), 16, SkColorSetA(entry.color, 0xff))));
+  }
+  AddSeparator(ui::NORMAL_SEPARATOR);
+  AddItemWithStringId(kManage, IDS_HELIUM_CONTAINER_MANAGE);
+}
+
+NamedContainerMenuModel::~NamedContainerMenuModel() = default;
+
+bool NamedContainerMenuModel::IsCommandIdChecked(int command) const {
+  if (!browser_ || command == kManage) {
+    return false;
+  }
+  for (const auto& handle : tabs_) {
+    auto* tab = handle.Get();
+    if (!tab || tab->GetBrowserWindowInterface() != browser_.get()) {
+      continue;
+    }
+    const auto& config = tab->GetContents()
+                             ->GetSiteInstance()
+                             ->GetSecurityPrincipal()
+                             .GetStoragePartitionConfig();
+    if (command == kNoContainer && config.is_default()) {
+      return true;
+    }
+    const auto index = static_cast<size_t>(command - kFirstContainer);
+    if (index < ids_.size() &&
+        config.partition_domain() == helium::containers::kPartitionDomain &&
+        config.partition_name() == ids_[index]) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool NamedContainerMenuModel::IsCommandIdEnabled(int command) const {
+  if (!browser_ || !helium::containers::IsAvailable(browser_->GetProfile())) {
+    return false;
+  }
+  if (command == kManage) {
+    return true;
+  }
+  return std::ranges::any_of(tabs_, [this](auto handle) {
+    return ReopenUrl(handle.Get(), browser_.get()).is_valid();
+  });
+}
+
+void NamedContainerMenuModel::ExecuteCommand(int command, int event_flags) {
+  if (!IsCommandIdEnabled(command)) {
+    return;
+  }
+  if (command == kManage) {
+    chrome::ShowSettingsSubPage(browser_.get(), "containers");
+    return;
+  }
+  std::optional<content::StoragePartitionConfig> partition;
+  if (command != kNoContainer) {
+    size_t index = static_cast<size_t>(command - kFirstContainer);
+    if (index >= ids_.size() ||
+        !helium::containers::HasId(browser_->GetProfile(), ids_[index])) {
+      return;
+    }
+    partition = content::StoragePartitionConfig::Create(
+        browser_->GetProfile(), helium::containers::kPartitionDomain,
+        ids_[index], false);
+  }
+  // Opening a tab can dismiss and destroy the menu. Work from local handles.
+  const auto browser = browser_;
+  const auto tabs = tabs_;
+  for (const auto& handle : tabs) {
+    if (!browser) {
+      return;
+    }
+    const GURL url = ReopenUrl(handle.Get(), browser.get());
+    if (!url.is_valid()) {
+      continue;
+    }
+    NavigateParams params(browser.get(), url, ui::PAGE_TRANSITION_TYPED);
+    params.disposition = WindowOpenDisposition::kNewForegroundTab;
+    params.started_from_context_menu = true;
+    params.storage_partition_config = partition;
+    Navigate(&params);
+  }
+}
