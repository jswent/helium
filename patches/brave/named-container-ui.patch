+IN_PROC_BROWSER_TEST_F(NamedContainerUiTest, ManageAndOpenFromNativeMenu) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL site = embedded_test_server()->GetURL("/title1.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), site));
+  auto* ordinary = active();
+  ASSERT_TRUE(
+      content::ExecJs(ordinary, "document.cookie='login=ordinary; path=/'"));
+  ASSERT_TRUE(Select("Manage containers…"));
+  auto* settings = active();
+  ASSERT_NE(ordinary, settings);
+  ASSERT_TRUE(content::WaitForLoadStop(settings));
+  InstallSelectors(settings);
+  ASSERT_TRUE(content::ExecJs(settings, R"JS(
+    (async () => {
+      const page = await untilUI(() => findControl('settings-containers-page'));
+      page.shadowRoot.querySelector('#add').click();
+      await editorSave('UI test');
+    })()
+  )JS"));
+  const auto original_id =
+      content::EvalJs(settings, "listRow('UI test').dataset.id")
+          .ExtractString();
+  strip()->ActivateTabAt(strip()->GetIndexOfWebContents(ordinary));
+  ASSERT_TRUE(Select("UI test"));
+  auto* first = active();
+  ASSERT_NE(first, ordinary);
+  ASSERT_TRUE(content::WaitForLoadStop(first));
+  EXPECT_EQ(site, first->GetLastCommittedURL());
+  EXPECT_EQ("", content::EvalJs(first, "document.cookie"));
+  ASSERT_TRUE(
+      content::ExecJs(first, "document.cookie='login=contained; path=/'; "
+                             "localStorage.setItem('marker','old')"));
+  strip()->ActivateTabAt(strip()->GetIndexOfWebContents(settings));
+  ASSERT_TRUE(content::ExecJs(settings, R"JS(
+    (async () => {
+      listRow('UI test').querySelector('.edit').click();
+      await editorSave('Renamed UI test');
+    })()
+  )JS"));
+  strip()->ActivateTabAt(strip()->GetIndexOfWebContents(ordinary));
+  EXPECT_FALSE(Select("UI test", false));
+  ASSERT_TRUE(Select("Renamed UI test"));
+  ASSERT_TRUE(content::WaitForLoadStop(active()));
+  EXPECT_EQ("login=contained", content::EvalJs(active(), "document.cookie"));
+  EXPECT_EQ("old", content::EvalJs(active(), "localStorage.getItem('marker')"));
+  ASSERT_TRUE(Select("No container"));
+  ASSERT_TRUE(content::WaitForLoadStop(active()));
+  EXPECT_EQ("login=ordinary", content::EvalJs(active(), "document.cookie"));
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), GURL("chrome://newtab/")));
+  ASSERT_TRUE(Select("Renamed UI test"));
+  ASSERT_TRUE(content::WaitForLoadStop(active()));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), site));
+  EXPECT_EQ("login=contained", content::EvalJs(active(), "document.cookie"));
+  strip()->ActivateTabAt(strip()->GetIndexOfWebContents(settings));
+  ASSERT_TRUE(content::ExecJs(settings, R"JS(
+    (async () => {
+      listRow('Renamed UI test').querySelector('.delete').click();
+      const page = findControl('settings-containers-page');
+      (await untilUI(() => page.shadowRoot.querySelector('#confirm'))).click();
+      await untilUI(() => !listRow('Renamed UI test') && !page.shadowRoot.querySelector('cr-dialog'));
+    })()
+  )JS"));
+  strip()->ActivateTabAt(strip()->GetIndexOfWebContents(first));
+  EXPECT_FALSE(Select("Renamed UI test", false));
+  EXPECT_EQ("", content::EvalJs(first, "document.cookie"));
+  EXPECT_EQ(true,
+            content::EvalJs(first, "localStorage.getItem('marker') === null"));
+  EXPECT_EQ("login=ordinary", content::EvalJs(ordinary, "document.cookie"));
+  strip()->ActivateTabAt(strip()->GetIndexOfWebContents(settings));
+  ASSERT_TRUE(content::ExecJs(settings, R"JS(
+    (async () => {
+      findControl('settings-containers-page').shadowRoot.querySelector('#add').click();
+      await editorSave('Renamed UI test');
+    })()
+  )JS"));
+  EXPECT_NE(original_id,
+            content::EvalJs(settings, "listRow('Renamed UI test').dataset.id")
+                .ExtractString());
+  strip()->ActivateTabAt(strip()->GetIndexOfWebContents(ordinary));
+  ASSERT_TRUE(Select("Renamed UI test"));
+  ASSERT_TRUE(content::WaitForLoadStop(active()));
+  EXPECT_EQ("", content::EvalJs(active(), "document.cookie"));
+}
