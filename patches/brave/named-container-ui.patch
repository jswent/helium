+
+// The numeric indices are persisted by the browser.
+export const ICONS = [
+  ['cr:person-filled', 'containerPerson'], ['cr:domain', 'containerWork'],
+  ['cr:group-filled', 'containerGroup'], ['cr:star-filled', 'containerStar'],
+  ['settings20:home', 'containerHome'], ['cr:location-on-filled', 'containerTravel'],
+] as const;
