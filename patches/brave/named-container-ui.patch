+namespace settings {
+NamedContainersHandler::NamedContainersHandler() = default;
+NamedContainersHandler::~NamedContainersHandler() = default;
+void NamedContainersHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getNamedContainers", base::BindRepeating(&NamedContainersHandler::Get,
+                                                base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "saveNamedContainer", base::BindRepeating(&NamedContainersHandler::Save,
+                                                base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "deleteNamedContainer",
+      base::BindRepeating(&NamedContainersHandler::Remove,
+                          base::Unretained(this)));
+}
+void NamedContainersHandler::OnJavascriptAllowed() {
+  registrar_.Init(Profile::FromWebUI(web_ui())->GetPrefs());
+  auto changed = base::BindRepeating(&NamedContainersHandler::Changed,
+                                     base::Unretained(this));
+  registrar_.Add(prefs::kHeliumNamedContainers, changed);
+  registrar_.Add(helium::containers::kAppearancePref, changed);
+}
+void NamedContainersHandler::OnJavascriptDisallowed() {
+  registrar_.RemoveAll();
+  weak_factory_.InvalidateWeakPtrs();
+}
+base::ListValue NamedContainersHandler::List() {
+  base::ListValue items;
+  for (const auto& entry :
+       helium::containers::List(Profile::FromWebUI(web_ui()))) {
+    items.Append(base::DictValue()
+                     .Set("id", entry.id)
+                     .Set("name", entry.name)
+                     .Set("icon", static_cast<int>(entry.icon))
+                     .Set("color", entry.color));
+  }
+  return items;
+}
+void NamedContainersHandler::Changed() {
+  FireWebUIListener("named-containers-changed", List());
+}
+void NamedContainersHandler::Get(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], List());
+}
+void NamedContainersHandler::Save(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 5u);
+  AllowJavascript();
+  ResolveJavascriptCallback(
+      args[0], base::Value(helium::containers::Save(
+                   Profile::FromWebUI(web_ui()), args[1].GetString(),
+                   args[2].GetString(), args[3].GetInt(), args[4].GetInt())));
+}
+void NamedContainersHandler::Remove(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 2u);
+  AllowJavascript();
+  helium::containers::Remove(
+      Profile::FromWebUI(web_ui()), args[1].GetString(),
+      base::BindOnce(
+          [](base::WeakPtr<NamedContainersHandler> handler,
+             base::Value callback, bool ok) {
+            if (handler) {
+              handler->ResolveJavascriptCallback(
+                  callback, base::Value(ok ? "" : "containerUnavailable"));
+            }
+          },
+          weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
