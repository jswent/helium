+  }
+  private update_(change: Partial<ContainerEntry>) {
+    this.draft_ = {...this.draft_!, ...change};
+    this.error_ = '';
+  }
+
+  protected onCancelClick_() { this.shadowRoot.querySelector<CrDialogElement>('cr-dialog')!.cancel(); }
+
+  protected onDialogClose_() {
+    this.draft_ = null;
+    const trigger = this.trigger_?.isConnected ? this.trigger_ :
+        this.shadowRoot.querySelector<HTMLElement>('#add');
+    trigger?.focus();
+  }
+
+  protected async onConfirmClick_() {
+    const item = this.draft_;
+    if (!item || this.busy_ || (!this.deleting_ && !item.name.trim())) return;
+    this.busy_ = true;
