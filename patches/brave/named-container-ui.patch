+
+export function getHtml(this: SettingsContainersPageElement) {
+  return html`<!--_html_template_start_-->
+<settings-subpage page-title="$i18n{containersTitle}" route-path="${this.routePath}">
+  <div class="cr-row first">
+    <div class="flex cr-padded-text">$i18n{containersDescription}</div>
+    <cr-button id="add" @click="${this.onAddClick_}">$i18n{containerAdd}</cr-button>
+  </div>
+  <div class="list-frame">
+    ${repeat(this.items_, item => item.id, item => html`
+      <div class="list-item" data-id="${item.id}">
+        <cr-icon class="badge" icon="${ICONS[item.icon][0]}" style="color:${colorHex(item.color)}" aria-hidden="true"></cr-icon>
+        <span class="name flex">${item.name}</span>
+        <cr-icon-button iron-icon="cr:edit-filled" class="edit"
+            aria-label="${loadTimeData.getStringF('containerEditNamed', item.name)}"
+            title="$i18n{edit}" data-id="${item.id}" @click="${this.onEditClick_}"></cr-icon-button>
+        <cr-icon-button iron-icon="cr:delete" class="delete"
+            aria-label="${loadTimeData.getStringF('containerDeleteNamed', item.name)}"
+            title="$i18n{delete}" data-id="${item.id}" @click="${this.onDeleteClick_}"></cr-icon-button>
+      </div>`)}
+  </div>
+</settings-subpage>
+${this.draft_ ? html`
+  <cr-dialog show-on-attach @close="${this.onDialogClose_}"
+      @cancel="${this.onDialogCancel_}">
+    <div slot="title">${this.deleting_ ? loadTimeData.getStringF('containerDeleteNamed', this.draft_.name) :
+        loadTimeData.getString(this.draft_.id ? 'containerEdit' : 'containerAdd')}</div>
+    <div slot="body">
+      ${this.deleting_ ? html`$i18n{containerDeleteDescription}` : html`
+        <cr-input id="name" label="$i18n{containerName}" maxlength="20"
+            .value="${this.draft_.name}" ?disabled="${this.busy_}"
+            @input="${this.onNameInput_}"
+            @keydown="${this.onNameKeydown_}"></cr-input>
+        <div class="choices">
+          <label>$i18n{containerIcon}
+            <select id="icon" class="md-select" ?disabled="${this.busy_}"
+                @change="${this.onIconChange_}">
+              ${ICONS.map(([, label], i) => html`<option value="${i}" ?selected="${this.draft_?.icon === i}">${loadTimeData.getString(label)}</option>`)}
+            </select>
+          </label>
