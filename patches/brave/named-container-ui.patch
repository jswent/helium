+namespace helium::containers {
+namespace {
+
+bool ValidStyle(int icon, int color) {
+  return icon >= 0 && icon <= static_cast<int>(Icon::kMaxValue) && color >= 0 &&
+         color <= 0xffffff;
+}
+
+std::optional<std::string> NameForId(Profile* profile, const std::string& id) {
+  if (!base::Uuid::ParseLowercase(id).is_valid()) {
+    return std::nullopt;
+  }
+  for (auto item :
+       profile->GetPrefs()->GetDict(prefs::kHeliumNamedContainers)) {
+    if (item.second.is_string() && item.second.GetString() == id) {
+      return item.first;
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+bool IsAvailable(Profile* profile) {
+  return profile && profile->IsRegularProfile() &&
+         base::FeatureList::IsEnabled(kHeliumNamedContainers);
+}
+
+std::vector<Entry> List(Profile* profile) {
+  std::vector<Entry> entries;
+  if (!IsAvailable(profile)) {
+    return entries;
+  }
+  auto* prefs = profile->GetPrefs();
+  const auto& appearance = prefs->GetDict(kAppearancePref);
+  for (auto item : prefs->GetDict(prefs::kHeliumNamedContainers)) {
+    const auto* id = item.second.GetIfString();
+    if (!id || !base::Uuid::ParseLowercase(*id).is_valid()) {
+      continue;
+    }
+    Entry entry{*id, item.first, Icon::kPerson, 0x3971ce};
+    if (*id == "2c2777a1-80b3-4b26-b629-ae1aefd9f272") {
+      entry.icon = Icon::kWork;
+      entry.color = 0xcb4859;
+    } else if (*id == "cfc3ee90-a163-4bd0-99ff-f0a472dda804") {
+      entry.icon = Icon::kGroup;
+      entry.color = 0x8157bd;
+    } else if (*id == "f5d49086-1a5f-42b0-83fa-58682e5b8ba5") {
+      entry.icon = Icon::kStar;
+      entry.color = 0x288050;
+    }
+    if (const auto* style = appearance.FindDict(*id)) {
+      int icon = style->FindInt("icon").value_or(-1);
+      int color = style->FindInt("color").value_or(-1);
+      if (ValidStyle(icon, color)) {
+        entry.icon = static_cast<Icon>(icon);
+        entry.color = color;
+      }
+    }
+    entries.push_back(std::move(entry));
+  }
+  return entries;
+}
+
+bool HasId(Profile* profile, const std::string& id) {
+  return IsAvailable(profile) && NameForId(profile, id).has_value();
+}
+
+content::StoragePartitionConfig GetOrCreateNamedPartition(
+    Profile* profile,
+    const std::string& name) {
+  CHECK(IsAvailable(profile));
+  auto* service = profile->GetPrefs();
+  const auto* stored =
+      service->GetDict(prefs::kHeliumNamedContainers).FindString(name);
+  auto id = stored ? base::Uuid::ParseLowercase(*stored) : base::Uuid();
+  if (!id.is_valid()) {
+    id = base::Uuid::GenerateRandomV4();
+    ScopedDictPrefUpdate update(service, prefs::kHeliumNamedContainers);
+    update->Set(name, id.AsLowercaseString());
+  }
+  return content::StoragePartitionConfig::Create(profile, kPartitionDomain,
+                                                 id.AsLowercaseString(), false);
+}
+
+std::string Save(Profile* profile,
+                 const std::string& id,
+                 const std::string& input,
+                 int icon,
+                 int color) {
+  if (!IsAvailable(profile)) {
+    return "containerUnavailable";
+  }
+  const auto old = NameForId(profile, id);
+  if (!id.empty() && !old) {
+    return "containerUnavailable";
+  }
+  std::u16string name16;
+  base::TrimWhitespace(base::UTF8ToUTF16(input), base::TRIM_ALL, &name16);
+  const std::string name = base::UTF16ToUTF8(name16);
+  // The launcher historically accepted long names. Keep existing identities
+  // editable, while using Brave's 20-character field limit for new names.
+  if (name16.empty() || (name16.size() > 20 && old != name) ||
+      std::ranges::any_of(name16,
+                          [](char16_t c) { return c < 0x20 || c == 0x7f; }) ||
+      !ValidStyle(icon, color)) {
+    return "containerInvalid";
+  }
+  auto* service = profile->GetPrefs();
+  const auto& names = service->GetDict(prefs::kHeliumNamedContainers);
+  if (names.contains(name) && old != name) {
+    return "containerDuplicate";
+  }
+  const std::string key =
+      old ? id : base::Uuid::GenerateRandomV4().AsLowercaseString();
+  {
+    ScopedDictPrefUpdate appearance(service, kAppearancePref);
+    appearance->Set(key,
+                    base::DictValue().Set("icon", icon).Set("color", color));
+  }
+  {
+    ScopedDictPrefUpdate update(service, prefs::kHeliumNamedContainers);
+    if (old && *old != name) {
+      update->Remove(*old);
+    }
+    update->Set(name, key);
+  }
+  return {};
+}
+
+void Remove(Profile* profile,
+            const std::string& id,
+            base::OnceCallback<void(bool)> complete) {
+  const auto name =
+      IsAvailable(profile) ? NameForId(profile, id) : std::nullopt;
+  if (!name) {
+    std::move(complete).Run(false);
+    return;
+  }
+  // Keep the identity available for retry until the partition acknowledges
+  // cleanup. A late callback may only unlink the UUID it actually cleared.
+  auto done = base::BarrierCallback<bool>(
+      4, base::BindOnce(
+             [](base::WeakPtr<Profile> profile, std::string id,
+                base::OnceCallback<void(bool)> callback,
+                const std::vector<bool>& results) {
+               if (!profile ||
+                   std::ranges::find(results, false) != results.end()) {
+                 std::move(callback).Run(false);
+                 return;
+               }
+               if (const auto current = NameForId(profile.get(), id)) {
+                 auto* service = profile->GetPrefs();
+                 {
+                   ScopedDictPrefUpdate update(service,
+                                               prefs::kHeliumNamedContainers);
+                   update->Remove(*current);
+                 }
+                 {
+                   ScopedDictPrefUpdate update(service, kAppearancePref);
+                   update->Remove(id);
+                 }
+               }
+               std::move(callback).Run(true);
+             },
+             profile->GetWeakPtr(), id, std::move(complete)));
+  auto config = content::StoragePartitionConfig::Create(
+      profile, kPartitionDomain, id, false);
+  auto* partition = profile->GetStoragePartition(config);
+  partition->ClearData(
+      content::StoragePartition::REMOVE_DATA_MASK_ALL, nullptr,
+      base::NullCallback(), network::mojom::CookieDeletionFilter::New(), true,
+      base::Time(), base::Time::Max(), base::BindOnce(done, true));
+  partition->ClearCodeCaches(base::Time(), base::Time::Max(),
+                             base::NullCallback(), base::BindOnce(done, true));
+  auto acknowledged = [&done] {
+    return mojo::WrapCallbackWithDropHandler(base::BindOnce(done, true),
+                                             base::BindOnce(done, false));
+  };
+  partition->GetNetworkContext()->ClearHttpCache(
+      base::Time(), base::Time::Max(), nullptr, acknowledged());
+  partition->GetNetworkContext()->ClearHttpAuthCache(
+      base::Time(), base::Time::Max(), nullptr, acknowledged());
+}
+}  // namespace helium::containers
