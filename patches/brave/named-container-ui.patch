+  protected onAddClick_(event: Event) { this.showEditor_(event); }
+
+  private itemForEvent_(event: Event) {
+    const id = (event.currentTarget as HTMLElement).dataset['id'];
+    return this.items_.find(item => item.id === id);
+  }
+  protected onEditClick_(event: Event) {
+    const item = this.itemForEvent_(event);
+    if (item) this.showEditor_(event, item);
+  }
+  protected onDeleteClick_(event: Event) {
+    const item = this.itemForEvent_(event);
+    if (item) this.showEditor_(event, item, true);
+  }
+  protected onDialogCancel_(event: Event) {
+    if (this.busy_) event.preventDefault();
+  }
+  protected onNameInput_(event: Event) {
+    this.update_({name: (event.currentTarget as CrInputElement).value});
+  }
+  protected onIconChange_(event: Event) {
+    this.update_({icon: Number((event.target as HTMLSelectElement).value)});
+  }
+  protected onColorInput_(event: Event) {
+    this.update_({color: parseInt((event.target as HTMLInputElement).value.slice(1), 16)});
+  }
+  protected onNameKeydown_(event: KeyboardEvent) {
+    if (event.key === 'Enter' && !event.isComposing) {
+      event.preventDefault();
