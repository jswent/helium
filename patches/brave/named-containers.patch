+// Only the UUID is used as a storage key. Names, including dots and slashes,
+// are literal preference keys and never enter the filesystem path.
+content::StoragePartitionConfig GetOrCreateNamedPartition(
+    Profile* profile,
+    const std::string& name) {
+  PrefService* pref_service = profile->GetPrefs();
+  const std::string* stored =
+      pref_service->GetDict(prefs::kHeliumNamedContainers).FindString(name);
+  base::Uuid id = stored ? base::Uuid::ParseLowercase(*stored) : base::Uuid();
+  if (!id.is_valid()) {
+    id = base::Uuid::GenerateRandomV4();
+    ScopedDictPrefUpdate update(pref_service, prefs::kHeliumNamedContainers);
+    update->Set(name, id.AsLowercaseString());
+  }
+  return content::StoragePartitionConfig::Create(
+      profile, helium::containers::kPartitionDomain, id.AsLowercaseString(),
+      profile->IsOffTheRecord());
+}
 
