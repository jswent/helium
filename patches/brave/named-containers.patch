+std::optional<content::StoragePartitionConfig> GetNamedPartitionForNewTab(
+    const NavigateParams& params) {
+  if (!base::FeatureList::IsEnabled(
+          helium::containers::kHeliumNamedContainers)) {
+    return std::nullopt;
+  }
+  if (params.storage_partition_config) {
+    return params.storage_partition_config;
+  }
+  if (params.source_site_instance) {
+    const auto& config = params.source_site_instance->GetSecurityPrincipal()
+                             .GetStoragePartitionConfig();
+    if (config.partition_domain() == helium::containers::kPartitionDomain) {
+      return config;
+    }
+  }
+  return std::nullopt;
+}
