+bool TabStyleViews::HasMiniContainerAccent() const {
+  return container_accent_ &&
+         !GetContainerAccentInset(delegate()->GetView()->width());
+}
+
 void TabStyleViews::PaintContainerAccent(gfx::Canvas* canvas) const {
-  if (container_accent_) {
+  if (container_accent_ && !HasMiniContainerAccent()) {
     container_accent_->Paint(canvas, *this);
   }
 }
+
+void TabStyleViews::PaintMiniContainerAccent(
+    const views::PaintInfo& info) const {
+  if (!HasMiniContainerAccent()) {
+    return;
+  }
+  // The corner badge overlaps the site favicon and must be painted above it.
+  ui::PaintRecorder recorder(info.context(), info.paint_recording_size(),
+                             info.paint_recording_scale_x(),
+                             info.paint_recording_scale_y(), nullptr);
+  container_accent_->Paint(recorder.canvas(), *this);
+}
