+  ASSERT_NO_FATAL_FAILURE(visit(@"New Temporary Container", ""));
+  const auto first = active()
+                         ->GetSiteInstance()
+                         ->GetSecurityPrincipal()
+                         .GetStoragePartitionConfig();
+  EXPECT_TRUE(first.partition_name().starts_with("t-"));
+  ASSERT_TRUE(
+      content::ExecJs(active(), "document.cookie='login=temporary; path=/'"));
+  const auto metadata = helium::containers::FindTemporary(
+      browser()->GetProfile(), first.partition_name());
+  ASSERT_TRUE(metadata);
