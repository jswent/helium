+  ASSERT_TRUE(content::WaitForLoadStop(active()));
+  EXPECT_EQ("login=temporary", content::EvalJs(active(), "document.cookie"));
+  ASSERT_NO_FATAL_FAILURE(visit(@"New Temporary Container", ""));
+  const auto second = active()
+                          ->GetSiteInstance()
+                          ->GetSecurityPrincipal()
+                          .GetStoragePartitionConfig();
+  EXPECT_NE(first, second);
+  ASSERT_NO_FATAL_FAILURE(visit(@"No Container", "login=ordinary"));
+  ASSERT_NO_FATAL_FAILURE(visit(@"Work", "login=work"));
+  ASSERT_NO_FATAL_FAILURE(SelectPlus(@"Manage Containers"));
+  ASSERT_TRUE(content::WaitForLoadStop(active()));
+  EXPECT_EQ("/containers", active()->GetLastCommittedURL().path());
