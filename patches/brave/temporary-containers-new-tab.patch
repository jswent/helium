+void ScheduleTemporaryContainerCleanup(Profile* profile) {
+  if (!IsAvailable(profile) ||
+      profile->GetPrefs()->GetDict(prefs::kHeliumTemporaryContainers).empty() ||
+      profile->GetUserData(&StartupCleanup::kKey)) {
+    return;
+  }
+  auto* session = SessionServiceFactory::GetForProfile(profile);
+  auto* restore = TabRestoreServiceFactory::GetForProfile(profile);
+  if (!session || !restore) {
+    return;
+  }
+  auto cleanup = std::make_unique<StartupCleanup>(profile);
+  auto* job = cleanup.get();
+  profile->SetUserData(&StartupCleanup::kKey, std::move(cleanup));
+  job->Start(session, restore);
+}
