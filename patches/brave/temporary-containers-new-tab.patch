+class StartupCleanup : public base::SupportsUserData::Data,
+                       public sessions::TabRestoreServiceObserver {
+ public:
+  static constexpr char kKey = 0;
+  explicit StartupCleanup(Profile* profile) : profile_(profile) {}
+  void Start(SessionService* session, sessions::TabRestoreService* restore) {
+    for (const auto item :
+         profile_->GetPrefs()->GetDict(prefs::kHeliumTemporaryContainers)) {
+      if (item.first.starts_with("t-") &&
+          base::Uuid::ParseLowercase(std::string_view(item.first).substr(2))
+              .is_valid()) {
+        candidates_.insert(item.first);
+      }
+    }
+    observation_.Observe(restore);
+    session->GetLastSession(
+        base::BindOnce(&StartupCleanup::OnLastSession, weak_.GetWeakPtr()));
+    if (!restore->IsLoaded()) {
+      restore->LoadTabsFromLastSession();
+    }
+  }
+
+ private:
+  void Protect(const std::vector<sessions::SerializedNavigationEntry>& navs) {
+    for (const auto& nav : navs) {
+      candidates_.erase(nav.named_container_id());
+      candidates_.erase(
+          sessions::SerializedNavigationEntry::ContainerIdFromStorageURL(
+              nav.virtual_url()));
+    }
+  }
+  void OnLastSession(
+      std::vector<std::unique_ptr<sessions::SessionWindow>> windows,
+      SessionID,
+      sessions::CommandStorageReadStatus status,
+      sessions::SessionReplayResult replay) {
+    if (sessions::IsCommandStorageReadError(status) ||
+        replay == sessions::SessionReplayResult::kCorruptedCommand) {
+      observation_.Reset();
+      return;  // An incomplete read is not evidence that a partition is unused.
+    }
+    for (const auto& window : windows) {
+      for (const auto& tab : window->tabs) {
+        Protect(tab->navigations);
+      }
+    }
+    got_session_ = true;
+    MaybeClean();
+  }
+  void TabRestoreServiceDestroyed(sessions::TabRestoreService*) override {
+    observation_.Reset();
+  }
+  void TabRestoreServiceLoaded(sessions::TabRestoreService*) override {
+    MaybeClean();
+  }
+
+  template <class T>
+  void ProtectTabs(const sessions::tab_restore::Entry& entry) {
+    for (const auto& tab : static_cast<const T&>(entry).tabs) {
+      Protect(tab->navigations);
+    }
+  }
+  void MaybeClean() {
+    auto* restore = observation_.GetSource();
+    if (!got_session_ || !restore || !restore->IsLoaded()) {
+      return;
+    }
+    namespace tr = sessions::tab_restore;
+    for (const auto& entry : restore->entries()) {
+      switch (entry->type) {
+        case tr::TAB:
+          Protect(static_cast<const tr::Tab&>(*entry).navigations);
+          break;
+        case tr::WINDOW:
+          ProtectTabs<tr::Window>(*entry);
+          break;
+        case tr::GROUP:
+          ProtectTabs<tr::Group>(*entry);
+          break;
+        case tr::SPLIT:
+          ProtectTabs<tr::Split>(*entry);
+          break;
+      }
+    }
+    observation_.Reset();
+    for (const auto& pinned :
+         profile_->GetPrefs()->GetList(prefs::kPinnedTabs)) {
+      const auto* dict = pinned.GetIfDict();
+      if (const auto* id = dict ? dict->FindString("container_id") : nullptr) {
+        candidates_.erase(*id);
+      }
+    }
+    // A tab may have moved out of the restore list while the saved session was
+    // loading. An unloaded tab can still carry a serialized partition ID.
+    tabs::ForEachTabInterface([&](tabs::TabInterface* tab) {
+      auto* contents = tab->GetContents();
+      if (contents && contents->GetBrowserContext() == profile_) {
+        if (auto* entry = contents->GetController().GetLastCommittedEntry()) {
+          using Builder = sessions::ContentSerializedNavigationBuilder;
+          candidates_.erase(Builder::FromNavigationEntry(
+                                0, entry, Builder::EXCLUDE_PAGE_STATE)
+                                .named_container_id());
+        }
+      }
+      return true;
+    });
+    for (const auto& id : candidates_) {
+      auto config = content::StoragePartitionConfig::Create(
+          profile_, kPartitionDomain, id, false);
+      if (profile_->GetStoragePartition(config, /*can_create=*/false)) {
+        continue;
+      }
+      // Block concurrent CLI reuse while the old directory is being removed.
+      // If interrupted, the tombstone is retried on the next startup.
+      {
+        ScopedDictPrefUpdate update(profile_->GetPrefs(),
+                                    prefs::kHeliumTemporaryContainers);
+        auto* metadata = update->FindDict(id);
+        if (!metadata) {
+          continue;
+        }
+        metadata->Set("deleting", true);
+      }
+      // Chromium StoragePartitionImplMap hashes the partition name into a
+      // six-byte hex leaf. Only validated, locally stored temporary UUIDs
+      // reach this point.
+      const auto hash = crypto::hash::Sha256(id);
+      const auto path =
+          profile_->GetPath()
+              .AppendASCII("Storage")
+              .AppendASCII("ext")
+              .AppendASCII(kPartitionDomain)
+              .AppendASCII(base::HexEncode(base::span(hash).first<6>()));
+      // Use the same cache location as ProfileNetworkContextService, including
+      // managed disk-cache overrides. Only touch this partition's Cache leaf.
+      base::FilePath cache;
+      chrome::GetUserCacheDirectory(path, &cache);
+      const auto override_dir =
+          chrome_browser_net::GetDiskCacheDir(g_browser_process->local_state());
+      if (!override_dir.empty()) {
+        cache = override_dir.Append(cache.BaseName());
+      }
+      base::ThreadPool::PostTaskAndReplyWithResult(
+          FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+          base::BindOnce(
+              [](const base::FilePath& partition, const base::FilePath& cache) {
+                return base::DeletePathRecursively(
+                           cache.Append(chrome::kCacheDirname)) &&
+                       base::DeletePathRecursively(partition);
+              },
+              path, cache),
+          base::BindOnce(&StartupCleanup::OnDeleted, weak_.GetWeakPtr(), id));
+    }
+    candidates_.clear();
+  }
+  void OnDeleted(std::string id, bool success) {
+    if (success) {
+      ScopedDictPrefUpdate update(profile_->GetPrefs(),
+                                  prefs::kHeliumTemporaryContainers);
+      update->Remove(id);
+    }
+  }
+  raw_ptr<Profile> profile_;
+  std::set<std::string> candidates_;
+  bool got_session_ = false;
+  base::ScopedObservation<sessions::TabRestoreService,
+                          sessions::TabRestoreServiceObserver>
+      observation_{this};
+  base::WeakPtrFactory<StartupCleanup> weak_{this};
+};
