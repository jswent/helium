+    ASSERT_TRUE(content::WaitForLoadStop(active()));
+    EXPECT_NE(site, active()->GetLastCommittedURL());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), site));
+    EXPECT_EQ(std::string(cookie),
+              content::EvalJs(active(), "document.cookie"));
+  };
+  ASSERT_NO_FATAL_FAILURE(visit(@"Work", ""));
