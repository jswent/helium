+std::optional<Entry> FindTemporary(Profile* profile, const std::string& id) {
+  if (!IsAvailable(profile) || !id.starts_with("t-") ||
+      !base::Uuid::ParseLowercase(std::string_view(id).substr(2)).is_valid()) {
+    return std::nullopt;
+  }
+  const auto* data = profile->GetPrefs()
+                         ->GetDict(prefs::kHeliumTemporaryContainers)
+                         .FindDict(id);
+  if (!data || data->FindBool("deleting").value_or(false)) {
+    return std::nullopt;
+  }
+  const auto* name = data->FindString("name");
+  const auto color = data->FindInt("color");
+  if (!name || !color || !ValidStyle(0, *color)) {
+    return std::nullopt;
+  }
+  return Entry{id, *name, Icon::kPerson, *color};
+}
+
+content::StoragePartitionConfig GetTemporaryPartition(Profile* profile,
+                                                      const std::string& name) {
+  CHECK(IsAvailable(profile));
+  auto* prefs_service = profile->GetPrefs();
+  if (!name.empty()) {
+    for (const auto item :
+         prefs_service->GetDict(prefs::kHeliumTemporaryContainers)) {
+      auto entry = FindTemporary(profile, item.first);
+      if (entry && entry->name == name) {
+        return content::StoragePartitionConfig::Create(
+            profile, kPartitionDomain, entry->id, false);
+      }
+    }
+  }
+
+  const auto id =
+      base::StrCat({"t-", base::Uuid::GenerateRandomV4().AsLowercaseString()});
+  // The first two BIP-39 words depend only on the first 22 random bits.
+  // Sampling the indices directly avoids a wallet/cryptography dependency.
+  std::string label = name;
+  if (label.empty()) {
+    label = base::StrCat(
+        {base::RandomChoice(base::span(kTemporaryContainerWords)), " ",
+         base::RandomChoice(base::span(kTemporaryContainerWords))});
+    label[0] = base::ToUpperASCII(label[0]);
+  }
+  static constexpr auto kColors =
+      std::to_array<int>({0xff3c36, 0xf45202, 0xb08c00, 0x2fab5f, 0x35a0b4,
+                          0x488cff, 0x9973f8, 0xff1593});
+  ScopedDictPrefUpdate update(prefs_service, prefs::kHeliumTemporaryContainers);
+  update->Set(id, base::DictValue()
+                      .Set("name", label)
+                      .Set("color", base::RandomChoice(kColors)));
+  return content::StoragePartitionConfig::Create(profile, kPartitionDomain, id,
+                                                 false);
+}
